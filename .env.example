# Postgres connection string (Supabase or any Postgres).
# Supabase: Project Settings → Database → Connection string → "URI" (use the pooler/6543 for serverless).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Stripe (Phase 2)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Auth (Phase 3) — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (used for SEO canonical/sitemap/OG). No trailing slash.
NEXT_PUBLIC_BASE_URL="https://www.novaatozparts.com"

# Owner-only admin access. Comma-separated emails allowed into /admin.
# An account also needs role = 'admin', which only /admin-login grants (with the
# setup code below). Leave empty to rely on the role check alone.
ADMIN_EMAILS="owner@novaatozparts.com"

# One-time code asked on /admin-login when creating (or promoting) an admin account.
# Unset = no new admin can be created. Use a long random value, e.g. `openssl rand -hex 16`.
ADMIN_SETUP_CODE=""

# Transactional email (Resend). Without this, emails are silently skipped.
RESEND_API_KEY=""
# Must be a verified Resend domain (or use onboarding@resend.dev for testing).
RESEND_FROM_EMAIL="Nova A to Z Parts <orders@novaatozparts.com>"

# Image storage in production (Vercel Blob). Without it, uploads go to disk
# (fine for local/self-hosted, NOT for Vercel serverless).
BLOB_READ_WRITE_TOKEN=""
